{
  "name": "mcp-browser",
  "version": "0.1.0",
  "description": "AI 可操纵的简易 Electron 浏览器:多标签 + 搜索 + 书签 + MCP(stdio)服务器",
  "main": "./out/main/index.js",
  "author": "ruinb0w",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node scripts/ensure-electron.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "mcp": "npm run build && MCP=stdio electron .",
    "mcp:http": "npm run build && MCP_HTTP=1 electron .",
    "mcp:install": "node scripts/install-pi-mcp.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:mcp": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
