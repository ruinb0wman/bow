{
  "name": "mcp-browser",
  "version": "0.1.0",
  "description": "AI 可操纵的简易 Electron 浏览器:多标签 + 搜索 + 书签 + MCP(stdio / HTTP)服务器",
  "main": "./out/main/index.js",
  "author": "ruinb0w",
  "license": "MIT",
  "desktopName": "com.ruinb0w.bow",
  "build": {
    "appId": "com.ruinb0w.bow",
    "productName": "bow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "executableName": "bow",
      "syncDesktopName": true,
      "category": "Network;WebBrowser;",
      "synopsis": "AI 可操纵的简易浏览器(多标签 + MCP)",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/xhtml+xml"
      ],
      "desktop": {
        "entry": {
          "Name": "bow",
          "Comment": "AI 可操纵的简易浏览器(多标签 + MCP)",
          "StartupWMClass": "com.ruinb0w.bow"
        }
      }
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node scripts/ensure-electron.mjs",
    "build": "electron-vite build && npm run build:remote",
    "dist": "node scripts/dist.mjs",
    "start": "electron-vite preview",
    "mcp": "npm run build && node scripts/open-bow.mjs stdio",
    "mcp:http": "npm run build && node scripts/open-bow.mjs http",
    "mcp:install": "node scripts/install-pi-mcp.mjs",
    "pi:install-status": "node scripts/install-pi-agent-state.mjs",
    "pi:install-plugin": "pi install ./packages/pi-bow",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "test:mcp:terminal": "node scripts/mcp-terminal-smoke.mjs",
    "test:mcp:http": "node scripts/mcp-smoke.mjs --http",
    "test:e2e:device": "node scripts/e2e-device-inspect.mjs",
    "test:e2e:agent": "node scripts/e2e-agent-status.mjs",
    "test:e2e:tabid": "node scripts/e2e-tab-id-reveal.mjs",
    "test:e2e:termcwd": "node scripts/e2e-terminal-cwd.mjs",
    "test:e2e:editor": "node scripts/e2e-editor-open.mjs",
    "test:e2e:herd": "node scripts/e2e-herd.mjs",
    "test:e2e:remote": "node scripts/e2e-remote.mjs",
    "build:remote": "vite build --config vite.remote.config.ts",
    "test:pi:chat": "node scripts/pi-chat-smoke.mjs",
    "test:pi:ask": "node scripts/pi-ask-smoke.mjs",
    "dev:remote": "vite build --config vite.remote.config.ts --watch"
  },
  "dependencies": {
    "@lucide/vue": "^1.21.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@ruinb0w/ui": "link:../ui",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "vue": "^3.5.13",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
