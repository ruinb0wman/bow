{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "outDir": "out",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@plugins/*": ["./src/plugins/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/plugins/*/main.ts",
    "src/plugins/*/shared.ts",
    "src/plugins/*/rules.ts",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ]
}
